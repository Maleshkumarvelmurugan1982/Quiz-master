<?xml version="1.0" encoding="utf-8"?>
<!--
  QuizMaster - ASP.NET Web Forms (.aspx) on .NET Framework 4.8
  Most things you may need to change are in <connectionStrings> and <appSettings>.
-->
<configuration>

  <connectionStrings>
    <!--
      SQL Server Express (same as the old project). If your instance has another name,
      change ".\SQLEXPRESS". Using Visual Studio's LocalDB instead? Replace the Data Source with:
        Data Source=(localdb)\MSSQLLocalDB
      The database "QuizAppDB" is created automatically on first run if it does not exist.
    -->
    <add name="DefaultConnection"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=QuizAppDB;Integrated Security=True;MultipleActiveResultSets=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- AI quiz generation (OpenRouter). Get a free key at https://openrouter.ai/keys -->
    <add key="OpenRouter:ApiKey" value="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" />
    <add key="OpenRouter:Model" value="openrouter/free" />
    <add key="OpenRouter:MaxAttempts" value="3" />

    <!-- Create QuizAppDB from App_Data/schema.sql when it does not exist -->
    <add key="AutoCreateDatabase" value="true" />

    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />

    <!-- 15 MB uploads (AI generator), 5 minute timeout for AI requests -->
    <httpRuntime targetFramework="4.8" maxRequestLength="15360" executionTimeout="300" requestValidationMode="2.0" />

    <!-- Read .aspx files and send pages as UTF-8 (fixes emojis / dashes showing as "ðŸ“Š" or "â€”") -->
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />

    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" defaultUrl="~/Default.aspx" name=".QUIZMASTERAUTH"
             timeout="120" slidingExpiration="true" cookieless="UseCookies" />
    </authentication>

    <!-- Everything requires login, except the pages/folders opened up in <location> below -->
    <authorization>
      <deny users="?" />
    </authorization>

    <sessionState mode="InProc" timeout="120" />

    <!--
      validateRequest="false": users may type "<" in names, passwords and quiz questions
      (e.g. "List<int>"). Instead of blocking those requests, every value is HTML-encoded
      when it is shown (Fmt.H, Literal Mode="Encode", TextBox), which is what prevents XSS.
    -->
    <pages validateRequest="false">
      <namespaces>
        <add namespace="QuizApp.Code" />
      </namespaces>
    </pages>

    <customErrors mode="RemoteOnly" />
  </system.web>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="15728640" />
      </requestFiltering>
    </security>
    <validation validateIntegratedModeConfiguration="false" />
  </system.webServer>

  <!-- Public pages / static files -->
  <location path="Login.aspx">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Register.aspx">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Default.aspx">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Content">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Scripts">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>

</configuration>
